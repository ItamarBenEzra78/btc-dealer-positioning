[Unit]
Description=BTC Dealer Positioning - collector worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gex
WorkingDirectory=/home/gex/btc-dealer-positioning
Environment=SNAPSHOT_INTERVAL_MIN=30
# switch to Postgres by uncommenting:
# Environment=DATABASE_URL=postgresql+psycopg://user:pass@host/db
ExecStart=/home/gex/btc-dealer-positioning/.venv/bin/python worker.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
