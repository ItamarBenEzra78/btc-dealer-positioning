[Unit]
Description=BTC Dealer Positioning - Streamlit dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gex
WorkingDirectory=/home/gex/btc-dealer-positioning
ExecStart=/home/gex/btc-dealer-positioning/.venv/bin/streamlit run dashboard.py \
  --server.port 8501 --server.address 0.0.0.0 --server.headless true
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
