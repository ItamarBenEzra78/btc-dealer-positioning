[Unit]
Description=BTC Dealer Positioning - FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gex
WorkingDirectory=/home/gex/btc-dealer-positioning
ExecStart=/home/gex/btc-dealer-positioning/.venv/bin/uvicorn api:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
