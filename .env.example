# Environment variables — VARIABLE NAMES ONLY, no real values.
# Copy this file to .env (which is git-ignored) and fill in as needed.
#
# All variables here are OPTIONAL. The project runs with sensible defaults if
# none of them are set. There are NO API keys required by any code path
# (Deribit, CryptoGamma, and Forex Factory are all free public endpoints).

# SQLAlchemy database URL. Default: sqlite:///data/app.db (created on first run).
# Set this to a Postgres URL to swap storage without touching code:
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# How often the background worker (worker.py) captures a positioning snapshot.
# Integer minutes. Default: 30.
SNAPSHOT_INTERVAL_MIN=
